Test       : UPF Carbon NLCC log grid
Program    : qball
TestGroups : short-run
Enabled    : Yes

ExtraFile  : C_loggrid.upf
Input      : carbon_loggrid.inp
Reference  : carbon_loggrid_reference.xml

match ; ekin    ; GREPFIELD(out, '<ekin>',    2) ;     8.18993964
match ; econf   ; GREPFIELD(out, '<econf>',   2) ;     0.00000000
match ; eps     ; GREPFIELD(out, '<eps>',     2) ;    -1.24355293
match ; enl     ; GREPFIELD(out, '<enl>',     2) ;    -0.43234283
match ; ecoul   ; GREPFIELD(out, '<ecoul>',   2) ;   -14.18340074
match ; exc     ; GREPFIELD(out, '<exc>',     2) ;    -4.16602309
match ; esr     ; GREPFIELD(out, '<esr>',     2) ;     0.00261518
match ; eself   ; GREPFIELD(out, '<eself>',   2) ;    16.83042232
match ; ets     ; GREPFIELD(out, '<ets>',     2) ;     0.00000000
match ; etotal  ; GREPFIELD(out, '<etotal>',  2) ;   -11.83537996
