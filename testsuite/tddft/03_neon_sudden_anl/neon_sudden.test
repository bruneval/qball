Test       : RT-TDDFT Neon sudden start (traveling pseudopotentials, A^nl)
Program    : qball
TestGroups : short-run
Enabled    : Yes

ExtraFile  : Ne.psp8
ExtraFile  : anl_check.sh
Input      : neon_sudden.inp

# ground state
match ; etotal_gs      ; GREPFIELD(out, '<etotal>', 2) ; -33.35662277
# E_KS alone misses the work done by -v.Delta(A^nl) between steps 10 and 40:
# about 0.043 Ha (regression value, documents the spurious oscillation)
Precision  : 1e-2
match ; ks_balance     ; SHELL(sh anl_check.sh out ks_balance 10 40) ; 0.04330732
# exact relations, expected 0 (measured: 0.008 and 0.005; A^nl itself is
# about 0.22 and 0.13): printed A^nl = P - <p> (P from the density dipole) ...
Precision  : 2e-2
match ; anl_step10     ; SHELL(sh anl_check.sh out anl 10) ; 0.0
match ; anl_step40     ; SHELL(sh anl_check.sh out anl 40) ; 0.0
# ... and energy balance Delta(E_KS + A^nl.v) = v.Delta(P) (measured: -0.002 Ha)
Precision  : 5e-3
match ; energy_balance ; SHELL(sh anl_check.sh out balance 10 40) ; 0.0
