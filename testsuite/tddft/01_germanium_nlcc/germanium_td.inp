# Bulk Ge with a pseudopotential that has a model core charge (NLCC):
# ground state, then 10 real-time TDDFT steps without any perturbation.
# The total energy must stay at its ground-state value.
# Regression test for a bug where the exchange-correlation energy during
# RT-TDDFT ignored the core charge (energy jumped by about 17.8 Ha).
set cell 0.000 5.345 5.345 5.345 0.000 5.345 5.345 5.345 0.000 bohr
species germanium Ge.upf
atom Ge1 germanium 0.0000 0.0000 0.0000 bohr
atom Ge2 germanium 2.6725 2.6725 2.6725 bohr
set xc PBE
set ecut 20 rydberg
set ecutprec 8 rydberg
set wf_dyn PSDA
set nempty 8
set smearing fermi
set smearing_width 0.01 hartree
set threshold_scf 1.E-7 5

set nkpoints 2
kpoint 0.25 0.25  0.25 0.25
kpoint 0.25 0.25 -0.25 0.75

randomize_wf
run 0 100 5

set wf_dyn ETRS
set TD_dt 0.1 atomictime
run 10 1
